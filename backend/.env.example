# GitHub Personal Access Token (system/fallback token - needs read:org and repo scopes)
# This token is used as a fallback in development mode when user OAuth tokens are unavailable
GITHUB_TOKEN=your_github_token_here

# GitHub Organization name
GITHUB_ORG=foursquare

# GitHub OAuth Configuration
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Security - Session Management
# Generate with: node -p "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=your_session_secret_here

# Security - Token Encryption (must be 64 hex characters = 32 bytes)
# Generate with: node -p "require('crypto').randomBytes(32).toString('hex')"
ENCRYPTION_KEY=your_encryption_key_here

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_PATH=data/app.db

# Team names (comma-separated) - for CLI scripts
TEAM_NAMES=team1,team2

# API Server Configuration
PORT=3001
NODE_ENV=development

# Rate Limiting Configuration (optional)
REQUEST_DELAY_MS=0
MAX_RETRIES=16
INITIAL_BACKOFF_MS=1000
MAX_CONCURRENT_REQUESTS=2
